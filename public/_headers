# Security headers for every static asset (Cloudflare Workers static assets).
# Worker responses (HTML, API, 404) get the same headers, plus a nonce CSP,
# from server/middleware/0-a-security.ts. Each header is set once here (/*);
# the per-path rules below only add cache-control, so nothing is duplicated.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
# Cloudflare Workers static-assets headers (merged with the /assets/* rule
# Nitro generates). Image URLs are not content-hashed, so changed artwork must
# ship under a new content-versioned file name.
/bazaar/*
  cache-control: public, max-age=2592000, stale-while-revalidate=604800
/brand/*
  cache-control: public, max-age=31536000, immutable
/manifest.webmanifest
  cache-control: no-cache
/og.jpg
  cache-control: no-cache
/fonts/*
  cache-control: public, max-age=31536000, immutable
/store-logos/*
  cache-control: public, max-age=2592000, stale-while-revalidate=604800
/favicon.ico
  cache-control: no-cache
/sw.js
  cache-control: no-cache
/offline.html
  cache-control: no-cache
/rl-cargo.pdf
  cache-control: no-cache
