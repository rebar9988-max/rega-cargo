{
  // Rega Cargo — its own Worker, fully separate from the live REGA site
  // (worker `rega-platform`). Never point this config at that worker.
  //
  // `npm run build` (Nitro preset cloudflare-module) merges this file into
  // .output/server/wrangler.json and writes .wrangler/deploy/config.json, so
  // `npx wrangler deploy` from the repo root deploys the built output.
  // `main` and `assets` are set by Nitro (assets binding: ASSETS).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rega-cargo",
  "account_id": "ee07860dbb8e61ff6915758785baf89a",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Production lives on its custom domain. workers.dev stays enabled only so
  // the old URL rega-cargo.<subdomain>.workers.dev can 301 visitors (and
  // installed PWAs, via a self-unregistering /sw.js) to cargo.regaplatform.com
  // — see scripts/legacy-host.mjs; it never serves the app. Version preview
  // URLs are off for production. Staging below keeps workers.dev.
  "workers_dev": true,
  "preview_urls": false,
  // Production custom domain (attached 2026-10-09). Only this hostname — the
  // apex and www.regaplatform.com belong to the REGA worker `rega-platform`
  // and must never be listed here.
  "routes": [{ "pattern": "cargo.regaplatform.com", "custom_domain": true }],

  // Database (Postgres) via Hyperdrive — see DEPLOY.md. Production only:
  // staging has no database (bindings are not inherited by env.staging).
  // For `wrangler dev` / `npm run cf:dev`, point the binding at a local
  // Postgres with the env var
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://…
  // (never commit a connection string here).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "795013d06b38408e87552686a6045291" }],

  // Plain (non-secret) runtime vars. Secrets are set with `wrangler secret put`
  // (see DEPLOY.md) and must NEVER be added here.
  "vars": {
    "BETTER_AUTH_URL": "https://cargo.regaplatform.com",
    // Don't inject the Grok app-builder extensions script (grok.com) into
    // production HTML — this app is no longer hosted on that platform.
    "VITE_GROK_EXTENSIONS": "0",
    // R&L AI (/ai, /api/ai/*): enabled in production (user-approved 2026-10-08).
    // Hard daily cap of identifications across all visitors.
    "RL_AI_ENABLED": "true",
    "RL_AI_DAILY_CAP": "200",
    // Product-link check (parse + shipping estimate; no provider data yet).
    "PRODUCT_LINK_ENABLED": "true",
    // Canonical origin for <link rel=canonical>, robots.txt and sitemap.xml.
    // Custom domain attached 2026-10-09 (owner-approved).
    "SITE_URL": "https://cargo.regaplatform.com"
  },

  // R&L AI: Workers AI binding + strongly consistent usage counter (daily cap and
  // per-visitor hourly limit) in a SQLite Durable Object (class in exports.cloudflare.ts).
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "RL_AI_USAGE", "class_name": "RlAiUsage" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RlAiUsage"] }],

  // Per-IP rate limit for quote signing and tracking lookups (20 / 60 s per key).
  "ratelimits": [{ "name": "RL_LIMIT", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } }],

  // Existing Cloudflare Builds runs `wrangler preview` for feature branches.
  // Preview bindings/vars are independent: no production database, secrets,
  // AI inference or retailer fetches. Primary journeys render truthful
  // unavailable states until an explicitly configured test backend exists.
  "previews": {
    "vars": {
      "VITE_GROK_EXTENSIONS": "0",
      "RL_AI_ENABLED": "false",
      "RL_AI_DAILY_CAP": "0",
      "PRODUCT_LINK_ENABLED": "false",
      "RL_NOINDEX": "1"
    }
  },

  // Staging: separate Worker `rega-cargo-staging` on workers.dev only (no
  // routes, no custom domain, no database, its own secrets). Deploy with
  // `npm run deploy:staging`. Bindings and vars are not inherited from the
  // top level, so everything staging needs is listed here.
  "env": {
    "staging": {
      "name": "rega-cargo-staging",
      "workers_dev": true,
      // Explicit, so staging doesn't inherit production's `false`.
      "preview_urls": true,
      "routes": [],
      // Only accepted on Workers Paid; deploying this verifies the plan.
      "limits": { "cpu_ms": 30000 },
      "vars": {
        "BETTER_AUTH_URL": "https://rega-cargo-staging.rebar9988.workers.dev",
        "VITE_GROK_EXTENSIONS": "0",
        "RL_AI_ENABLED": "true",
        // Hard daily cap on AI identifications (all visitors together).
        "RL_AI_DAILY_CAP": "200",
        "PRODUCT_LINK_ENABLED": "true",
        "SITE_URL": "https://rega-cargo-staging.rebar9988.workers.dev",
        // Staging is never indexed (x-robots-tag + robots.txt Disallow: /).
        "RL_NOINDEX": "1"
      },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "RL_AI_USAGE", "class_name": "RlAiUsage" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RlAiUsage"] }],
      "ratelimits": [{ "name": "RL_LIMIT", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } }]
    }
  }
}
